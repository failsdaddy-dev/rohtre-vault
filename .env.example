# Copy to .env.local and fill in. Never commit .env.local.
# Supabase Dashboard -> Settings -> API Keys (and the Connect dialog)

# Public values (safe in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Never put a secret key in a NEXT_PUBLIC_* variable.
# Not needed by the web app at all: Edge Functions get the secret key from Supabase.
